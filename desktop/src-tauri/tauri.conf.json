{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "eclume",
  "version": "0.3.0",
  "identifier": "io.github.holetz.eclume",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "eclume",
        "width": 520,
        "height": 600,
        "minWidth": 380,
        "minHeight": 420,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "appimage",
      "deb",
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "shortDescription": "Grava reuniões e envia para transcrição no eclume.",
    "longDescription": "App desktop do eclume: grava reuniões (microfone e áudio do sistema), guarda a fila local de gravações e sincroniza com o servidor eclume, na bandeja do sistema.",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR",
          "English"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "pt-BR"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libasound2t64 | libasound2",
          "libpulse0",
          "libpipewire-0.3-0t64 | libpipewire-0.3-0"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "15.0",
      "signingIdentity": "-",
      "hardenedRuntime": false
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNCMjdDRTUwRkZGRkNGNzUKUldSMXovLy9VTTRuTzRFZE4vT1RYN1pXakFuZzcxblJTeGpOVE50aWVYSG9FOWR0K1V1UHBzMzYK",
      "endpoints": [
        "https://192.168.15.199:8443/downloads/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
