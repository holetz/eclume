{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "eclume",
  "version": "0.1.0",
  "identifier": "io.github.holetz.eclume",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "eclume",
        "width": 520,
        "height": 600,
        "minWidth": 380,
        "minHeight": 420,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
