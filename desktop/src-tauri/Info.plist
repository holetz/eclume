<plist version="1.0">
<dict>
  <!-- Merged by the Tauri bundler into eclume.app's Info.plist: macOS requires the descriptions
       to allow the microphone and system audio capture (process tap). The strings are pt-BR
       copy macOS shows the person. -->
  <key>NSMicrophoneUsageDescription</key>
  <string>O eclume grava o microfone durante as reuniões para transcrevê-las.</string>
  <key>NSAudioCaptureUsageDescription</key>
  <string>O eclume grava o áudio das reuniões que toca no computador para transcrevê-las.</string>
</dict>
</plist>
