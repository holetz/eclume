# Servidor estático da imagem eclume-web. TLS e roteamento ficam no Caddy de borda.
{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip
	# A CSP viaja com a imagem (produção, e2e e quem usar outro proxy). O áudio vem de /media na
	# mesma origem e o ffmpeg.wasm dos assets do Vite: `'self'` basta; o wasm pede
	# `'wasm-unsafe-eval'` e o worker do ffmpeg, `blob:`. Contrato em docs/standards/code/frontend-web.md.
	header {
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'none'; object-src 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
	# Os assets do Vite têm hash no nome: cache longo, só para o arquivo que existe. Sem `try_files`,
	# o asset ausente (chunk de um deploy anterior) é 404 sem cache, e o `import()` falha rápido e
	# com motivo, em vez de guardar o index.html por um ano naquela URL.
	handle /assets/* {
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	# A referência da API (/referencia-api.html, gerada pelo build do web) é HTML do Redoc: o CSS do
	# styled-components vem em <style> inline e a busca roda num worker `blob:`. Só este caminho
	# relaxa `style-src`; os scripts são arquivos da mesma origem. Norma em docs/standards/api/contrato-v1.md.
	@referencia path /referencia-api.html /referencia-api/*
	handle @referencia {
		header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; script-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'none'; object-src 'none'"
		header Cache-Control "no-cache"
		file_server
	}
	# O resto (o index.html de toda rota do SPA) nunca é cacheado.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
	handle_errors {
		header Cache-Control "no-store"
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}
