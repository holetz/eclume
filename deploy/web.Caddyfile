# SPA rules in the edge image (`eclume-edge`, deploy/web.Dockerfile): each compose's Caddyfile
# (production, staging, e2e) includes it with `import /etc/caddy/spa.caddy` INSIDE the site block,
# after the /api, /media, /mcp and /downloads routes. The `handle` without a matcher is the site's
# last one, so it only takes the rest. No SPA route may start with /api, /media, /mcp or /downloads.
handle {
	root * /srv/web
	encode zstd gzip
	# The CSP travels with the image (production, e2e and whoever uses another proxy). The audio comes
	# from /media on the same origin and ffmpeg.wasm from the Vite assets: `'self'` is enough; the wasm
	# needs `'wasm-unsafe-eval'` and the ffmpeg worker, `blob:`. Contract in docs/standards/code/frontend-web.md.
	header {
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'none'; object-src 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
	# The Vite assets have a hash in the name: long cache, only for the file that exists. Without
	# `try_files`, a missing asset (a chunk of an earlier deploy) is an uncached 404, and the `import()`
	# fails fast and with a reason, instead of keeping index.html for a year at that URL.
	handle /assets/* {
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	# The API reference (/referencia-api.html, generated by the web build) is Redoc HTML: the
	# styled-components CSS comes inline in <style> and the search runs in a `blob:` worker. Only this
	# path relaxes `style-src`; the scripts are same-origin files. Rule in docs/standards/api/contrato-v1.md.
	@apireference path /referencia-api.html /referencia-api/*
	handle @apireference {
		header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; script-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'none'; object-src 'none'"
		header Cache-Control "no-cache"
		file_server
	}
	# The rest (the index.html of every SPA route) is never cached.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
handle_errors {
	header Cache-Control "no-store"
	respond "{err.status_code} {err.status_text}" {err.status_code}
}
