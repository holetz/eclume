# Variables the deploy scripts read from the operator's shell (deploy.sh, gate.sh, release-*.sh,
# bootstrap-admin.sh, smoke_*.py). None has a default that names a host: set them for your own
# server, for example in your shell profile or with `set -a; source <your copy>; set +a`.
# Keep your copy outside the repository (it names your host).

# The `ssh://` Docker context that points at the server (`docker context create <name> --docker host=ssh://<user>@<host>`).
ECLUME_DOCKER_CONTEXT=<context>

# Only when the context is not ssh://: the user@host the scripts use to run commands over SSH.
# ECLUME_SSH=<user>@<host>

# The public address of the deployment. The smokes and the browser proofs treat it as production and
# refuse writing proofs against it; RFC 5737 documentation address below.
ECLUME_PUBLIC_URL=https://192.0.2.10:8443

# The administrator's e-mail for bootstrap-admin.sh and the smokes.
# ECLUME_ADMIN_EMAIL=admin@example.org

# Host disk use (percent) at which the deploy refuses. Default 90.
# ECLUME_DISK_LIMIT=90
