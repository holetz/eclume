# Variables of the production stack (deploy/docker-compose.prod.yml). Do not copy by hand:
#   bash deploy/deploy.sh --generate-env
# generates deploy/.env.prod (chmod 600, outside git) with random secrets. The deploy refuses while
# there is a `change-me-` value and keeps a copy in /srv/eclume/secrets/env.prod on the host.
# Secrets in hex (openssl rand -hex 24): the Postgres password goes into the DSN without escaping.

# --- Host ---
# IP (or name) through which the LAN reaches the host; eclume lives at https://<host>:8443.
ECLUME_PUBLIC_HOST=change-me-host-ip-or-name
# Absolute base of the URLs returned to the client (upload parts, audio).
ECLUME_PUBLIC_URL=https://change-me-host-ip-or-name:8443
# CA that issues the HTTPS (docs/project/deploy-producao.md, "CA raiz nos clientes"): `eclume` is the
# own root with a name constraint, which the deploy generates in ${ECLUME_DATA_DIR}/secrets/ca if
# missing; `local` is Caddy's root, without a constraint (the one of earlier installs, until the rotation).
ECLUME_TLS_CA=eclume
# Other IPs or DNS names the own root allows, comma- or space-separated, besides ECLUME_PUBLIC_HOST
# (e.g. holetz-pc.local). The root needs at least one IP. Changing it after it is generated does not
# change the root: it needs another rotation. ECLUME_CA_NOMES is the deprecated pt-BR name, still read.
ECLUME_CA_NAMES=
# Server name in the /api/v1/server descriptor and the instance announced over mDNS (_eclume._tcp).
ECLUME_SERVER_NAME=eclume
# Data directory ON THE HOST (pg, redis, minio, caddy/{data,config}, models, downloads, secrets, backups).
ECLUME_DATA_DIR=/srv/eclume
# Open signup (POST /api/v1/auth/signup): anyone on the LAN creates an account. `false` closes the
# signup without a code deploy: change it here and recreate the server (docs/project/deploy-producao.md).
ECLUME_SIGNUP_OPEN=true
# Ceiling of signups created per IP in a sliding 24 h window (besides the per-minute ceiling).
ECLUME_SIGNUPS_PER_IP_PER_DAY=5
# Long-lived Claude token (claude-cli provider): `claude setup-token` on the host, valid for 1 year.
# Empty = claude-cli fails with provider_not_configured.
ECLUME_CLAUDE_OAUTH_TOKEN=
# `claude` CLI in the server image (build arg; docs/standards/code/server-agentes.md): 1 installs the
# proprietary CLI of the claude-cli provider, 0 leaves the image with free software only. Required:
# the deploy refuses an env that does not declare 0 or 1, so production does not lose the CLI by omission.
ECLUME_CLAUDE_CLI=0

# --- Secrets ---
# The Postgres password only holds when the volume is created (to change it later: ALTER USER eclume PASSWORD).
ECLUME_PG_PASSWORD=change-me-openssl-rand-hex-24
# Password of the eclume_server role, the connection of the server and the CPU worker (no superuser).
# The `migrate` applies it on every deploy: changing it here and deploying changes the password. The
# deploy generates one if missing.
ECLUME_RUNTIME_PG_PASSWORD=change-me-openssl-rand-hex-24
# MinIO root: only MinIO, `minio-init` and the host backup use it.
ECLUME_MINIO_USER=eclume
ECLUME_MINIO_PASSWORD=change-me-openssl-rand-hex-24
# Per-service credential, which `minio-init` applies on every deploy: `eclume-server` (server and CPU
# workers) and `eclume-gpu` (only reads the audio and writes the artifacts). The deploy generates the missing ones.
ECLUME_MINIO_SERVER_PASSWORD=change-me-openssl-rand-hex-24
ECLUME_MINIO_GPU_PASSWORD=change-me-openssl-rand-hex-24
# Redis ACL (`default` user disabled): `eclume-server` and `eclume-gpu`. Hex: they go into the URL.
ECLUME_REDIS_SERVER_PASSWORD=change-me-openssl-rand-hex-24
ECLUME_REDIS_GPU_PASSWORD=change-me-openssl-rand-hex-24
# Signs the part and audio URLs. Changing it invalidates the URLs in circulation.
ECLUME_SECRET_KEY=change-me-openssl-rand-hex-32
# Encryption of the providers' API keys (base64 of 32 bytes: openssl rand -base64 32).
# Changing it invalidates the stored keys (the providers have to be registered again).
ECLUME_ENCRYPTION_KEY=change-me-openssl-rand-base64-32
