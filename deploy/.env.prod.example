# Variáveis do stack de produção (deploy/docker-compose.prod.yml). Não copie à mão:
#   bash deploy/deploy.sh --gerar-env
# gera deploy/.env.prod (chmod 600, fora do git) com segredos aleatórios. O deploy recusa enquanto
# houver um valor `troque-` e guarda uma cópia em /srv/eclume/secrets/env.prod no host.
# Segredos em hex (openssl rand -hex 24): a senha do Postgres entra na DSN sem escape.

# --- Host ---
# IP (ou nome) pelo qual a LAN chega ao host; o eclume fica em https://<host>:8443.
ECLUME_PUBLIC_HOST=192.168.15.199
# Base absoluta das URLs devolvidas ao cliente (partes do upload, áudio).
ECLUME_PUBLIC_URL=https://192.168.15.199:8443
# Diretório de dados NO HOST (pg, redis, minio, caddy/{data,config}, models, downloads, secrets, backups).
ECLUME_DATA_DIR=/srv/eclume
# Login do Claude Code do host, montado gravável no worker CPU (provider claude-cli).
# Vazio = /dev/null, e o claude-cli falha com provider_not_configured.
ECLUME_CLAUDE_CREDENTIALS=/home/holetz/.claude/.credentials.json

# --- Segredos ---
# A senha do Postgres só vale na criação do volume (para trocar depois: ALTER USER eclume PASSWORD).
ECLUME_PG_PASSWORD=troque-openssl-rand-hex-24
ECLUME_MINIO_USER=eclume
ECLUME_MINIO_PASSWORD=troque-openssl-rand-hex-24
# Assina as URLs de parte e de áudio. Trocar invalida as URLs em circulação.
ECLUME_SECRET_KEY=troque-openssl-rand-hex-32
# Cifra das chaves de API dos providers (base64 de 32 bytes: openssl rand -base64 32).
# Trocar invalida as chaves guardadas (os providers precisam ser recadastrados).
ECLUME_ENCRYPTION_KEY=troque-openssl-rand-base64-32
