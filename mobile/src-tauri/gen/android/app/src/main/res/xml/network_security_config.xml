<?xml version="1.0" encoding="utf-8"?>
<!-- No cleartext: the server is HTTPS with the CA pinned by the core (rustls), outside Android's
     trust store. The development server's HTTP (`tauri android dev`) is only allowed in the debug
     build (src/debug). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
