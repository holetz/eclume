<?xml version="1.0" encoding="utf-8"?>
<!-- Sem texto claro: o servidor é HTTPS com a CA fixada pelo núcleo (rustls), fora do trust store
     do Android. O HTTP do servidor de desenvolvimento (`tauri android dev`) só vale no build de
     depuração (src/debug). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
