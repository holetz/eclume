<?xml version="1.0" encoding="utf-8"?>
<!-- O atalho "Gravar agora" do ícone do eclume (pressionar o ícone; pode ser fixado na tela inicial).
     Só abre a MainActivity com a ação GRAVAR_AGORA: quem grava é a UI, pelo mesmo fluxo do botão
     Gravar (o serviço de microfone exige a Activity visível no Android 14+). O targetPackage e o
     targetClass acompanham o applicationId (holetz/eclume#17). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="gravar_agora"
        android:enabled="true"
        android:icon="@drawable/ic_atalho_gravar"
        android:shortcutShortLabel="@string/atalho_gravar_curto"
        android:shortcutLongLabel="@string/atalho_gravar_longo">
        <intent
            android:action="io.github.holetz.eclume.movel.GRAVAR_AGORA"
            android:targetPackage="io.github.holetz.eclume.movel"
            android:targetClass="io.github.holetz.eclume.movel.MainActivity" />
    </shortcut>
</shortcuts>
