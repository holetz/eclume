<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- The SyncWorker in the foreground, beyond WorkManager's 10-min limit. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- The request for the battery-optimization exemption (the app is not distributed through
         Play, whose policy restricts it). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application>
        <!-- The microphone stays on with the screen locked: a microphone-type foreground service,
             started with the Activity visible (the tap on Gravar). -->
        <service
            android:name=".RecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <!-- WorkManager's service that runs the SyncWorker in the foreground needs the dataSync
             type declared (Android 14+), merged into the library's. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
        <!-- The watchdog of the process that dies while recording: an internal, non-exported alarm.
             It keeps its class name: armed alarms name this component. -->
        <receiver
            android:name=".VigiaDaGravacao"
            android:exported="false" />
    </application>
</manifest>
